+void RendererImpl::rmeDrainForSession() {
+    android::base::AutoLock lock(mChannelsLock);
+    mStopped = true;
+    auto channels = std::move(mChannels);
+    lock.unlock();
+    for (const auto& c : channels) {
+        c->stopFromHost();
+    }
+    for (const auto& c : channels) {
+        c->renderThread()->wait();
+    }
+}
